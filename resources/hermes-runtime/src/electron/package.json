{
  "name": "knockdesk-electron-main",
  "version": "1.0.0",
  "description": "KnockDesk Electron Main Process",
  "private": true,
  "type": "commonjs",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch main.ts",
    "build": "npm run compile",
    "compile": "tsc --project tsconfig.build.json",
    "bytenode": "bytenode --compile dist/main.js --output dist/main.jsc",
    "bytenode:verify": "node -e \"require('bytenode'); require('./dist/main.jsc'); console.log('main.jsc loads successfully')\"",
    "build:bytecode": "npm run compile && npm run bytenode",
    "build:staged": "node ../../../../build-electron-main.mjs"
  },
  "dependencies": {
    "electron": "44.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bytenode": "^1.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
