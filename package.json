{
  "name": "knockdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Source-owned KnockDesk desktop workspace",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-knockdesk.mjs",
    "dev:knockdesk": "node scripts/dev-knockdesk.mjs",
    "test": "node --test scripts/build-pipeline.test.mjs",
    "build:knockdesk": "node build-electron-main.mjs",
    "check:knockdesk": "node --test scripts/build-pipeline.test.mjs && node build-electron-main.mjs",
    "list:asar": "node scripts/unpack-app-asar.mjs --list",
    "unpack:asar": "node scripts/unpack-app-asar.mjs --extract",
    "repack:asar": "node scripts/unpack-app-asar.mjs --pack",
    "unpack:all": "python scripts/unpack-all.py",
    "inventory": "python scripts/inventory.py",
    "check:privacy": "python scripts/privacy-scan.py",
    "check:secrets": "python scripts/secret-scan.py",
    "test:maintenance": "python -m unittest discover -s scripts -p \"test_maintenance_tools.py\" -v"
  }
}
